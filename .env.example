# Copy to .env and fill in. Never commit .env.

# Any LiteLLM model string works: https://docs.litellm.ai/docs/providers
# Gemini and Groq both have free tiers, which is enough for this project.
LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

EMBED_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=data
QDRANT_PATH=qdrant_data
COLLECTION=arxiv_chunks
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
# dense | bm25 | hybrid[@bm25_weight] , optionally + "-rerank"
RETRIEVER=hybrid@0.8
RERANKER_MODEL=BAAI/bge-reranker-base
