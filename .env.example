# Copy to .env and fill in. Never commit .env.

# Any LiteLLM model string works: https://docs.litellm.ai/docs/providers
# Gemini and Groq both have free tiers, which is enough for this project.
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

EMBED_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=data
QDRANT_PATH=qdrant_data
COLLECTION=arxiv_chunks
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
